<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LocalDraft.Core\LocalDraft.Core.csproj" />
    <ProjectReference Include="..\LocalDraft.Infrastructure\LocalDraft.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LocalDraft.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Models\manifest.json"
             Link="Models\manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
    <Content Include="..\..\Models\Whisper\*.bin"
             Link="Models\Whisper\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
    <Content Include="..\..\Models\Text\*.gguf"
             Link="Models\Text\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
    <Content Include="..\..\Native\Whisper\*.dll"
             Link="Native\Whisper\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
    <Content Include="..\..\Native\Whisper\whisper-cli.exe"
             Condition="Exists('..\..\Native\Whisper\whisper-cli.exe')"
             Link="Native\Whisper\whisper-cli.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LocalDraft</AssemblyName>
    <ApplicationIcon>Assets\LocalDraft.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
