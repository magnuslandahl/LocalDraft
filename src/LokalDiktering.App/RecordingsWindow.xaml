<Window x:Class="LokalDiktering.App.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspelningar" Height="610" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Inspelningar" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <DataGrid x:Name="RecordingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding CreatedLocal, StringFormat={}{0:g}}" Width="2*"/>
                <DataGridTextColumn Header="Längd" Binding="{Binding Duration}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StateLabel}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Det finns inga sparade inspelningar."
                   Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
        <WrapPanel x:Name="RecordingActionsPanel" Grid.Row="2" Margin="0,10" Visibility="Collapsed">
            <Button Content="Spela upp" Click="PlayButton_Click"/>
            <Button Content="Transkribera igen" Click="RetranscribeButton_Click"/>
            <Button Content="Ta bort inspelning" Foreground="#A4262C" Click="DeleteButton_Click"/>
        </WrapPanel>
        <TextBox x:Name="PreviewBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="InsertButton" Content="Infoga vid markören" Visibility="Collapsed"
                    Style="{StaticResource PrimaryButton}" Click="InsertButton_Click"/>
            <Button x:Name="ReplaceButton" Content="Ersätt markerad text" Visibility="Collapsed"
                    Style="{StaticResource PrimaryButton}" Click="ReplaceButton_Click"/>
            <Button x:Name="CopyButton" Content="Kopiera" Visibility="Collapsed" Click="CopyButton_Click"/>
            <Button Content="Stäng" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
