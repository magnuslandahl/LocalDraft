<Window x:Class="LokalDiktering.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LokalDiktering.App"
        mc:Ignorable="d"
        Title="Lokal Diktering" Height="820" Width="1280" MinHeight="650" MinWidth="960"
        Background="#EEF1F5" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lokal Diktering" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#E8F5EC" CornerRadius="14" Padding="12,5">
                    <TextBlock Text="●  100 % lokalt" Foreground="#216E39" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Column="2" Content="Inställningar" Margin="12,0,0,0" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                <Button x:Name="CancelOperationButton" Content="Avbryt" HorizontalAlignment="Right"
                        Visibility="Collapsed" Click="CancelOperationButton_Click"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DocumentSidebar" Grid.Column="0" Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="+  Nytt dokument" Style="{StaticResource PrimaryButton}"
                               AutomationProperties.Name="Nytt dokument" Click="NewDocumentButton_Click"/>
                        <Button x:Name="DocumentMenuButton" Grid.Column="1" Content="⋯" Width="40"
                               ToolTip="Fler dokumentåtgärder" AutomationProperties.Name="Fler dokumentåtgärder"
                               Click="DocumentMenuButton_Click">
                            <Button.ContextMenu>
                               <ContextMenu x:Name="DocumentMenu">
                                   <MenuItem Header="Inspelningar" Click="RecordingsButton_Click"/>
                                   <MenuItem Header="Versioner" Click="VersionsButton_Click"/>
                                   <Separator/>
                                   <MenuItem Header="Kopiera allt" Click="CopyAllButton_Click"/>
                                   <Separator/>
                                   <MenuItem Header="Ta bort dokument…" Foreground="#A4262C"
                                             Click="DeleteDocumentButton_Click"/>
                               </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <TextBox DockPanel.Dock="Top" Margin="3,10,3,8" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Sök dokument" AutomationProperties.Name="Sök dokument"
                             TextChanged="FilterTextBox_TextChanged"/>
                    <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument}" SelectionChanged="DocumentList_SelectionChanged"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ModifiedLocal, StringFormat={}{0:g}}" Foreground="#667085"
                                               FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="EditorPanel" Background="White" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TitleBox" FontSize="20" FontWeight="SemiBold" BorderThickness="0"
                                 AutomationProperties.Name="Dokumenttitel" TextChanged="EditorChanged"/>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                            <ComboBox x:Name="StyleBox" Width="125" Height="36" SelectedIndex="0"
                                      SelectionChanged="StyleBox_SelectionChanged">
                                <ComboBoxItem Content="Brödtext"/>
                                <ComboBoxItem Content="Rubrik 1"/>
                                <ComboBoxItem Content="Rubrik 2"/>
                            </ComboBox>
                            <Button Content="Fet" FontWeight="Bold" Click="BoldButton_Click"/>
                            <Button Content="Kursiv" FontStyle="Italic" Click="ItalicButton_Click"/>
                            <Button Content="Punktlista" Click="BulletButton_Click"/>
                            <Button Content="Ångra" Click="UndoButton_Click"/>
                            <Button Content="Gör om" Click="RedoButton_Click"/>
                        </WrapPanel>
                        <RichTextBox x:Name="Editor" Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1" Padding="18" FontFamily="Segoe UI" FontSize="15"
                                     VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                                     TextChanged="EditorChanged" SelectionChanged="Editor_SelectionChanged"
                                     AutomationProperties.Name="Dokumenttext"/>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🎙  Diktera" FontSize="17" Padding="22,10"
                                        Style="{StaticResource PrimaryButton}" Click="DictateButton_Click"
                                        AutomationProperties.Name="Diktera"/>
                                <Button Content="Textassistent" Click="OpenAssistantButton_Click"
                                        AutomationProperties.Name="Öppna textassistent"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#667085"
                                       Text="Sparas automatiskt"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AssistantPanel" Visibility="Collapsed" Panel.ZIndex="10"
                        Width="370" HorizontalAlignment="Right" Margin="12"
                        Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Textassistent" FontSize="19" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Content="Stäng" HorizontalAlignment="Right" Padding="8,4"
                                        MinHeight="28" Click="CloseAssistantPanelButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="AssistantScope" Text="Hela dokumentet" Foreground="#667085"
                                       Margin="0,4,0,12"/>
                            <ListBox x:Name="AssistantHistoryList" Height="105" Margin="0,0,0,8"
                                     BorderBrush="{StaticResource BorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis"
                                                       Foreground="#667085"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Rensa chatt" HorizontalAlignment="Right" Padding="8,4"
                                    MinHeight="28" Click="ClearHistoryButton_Click"/>
                            <Button Content="Renskriv" Tag="Cleanup" Click="AssistantActionButton_Click"/>
                            <Button Content="Sammanfatta" Tag="Summarize" Click="AssistantActionButton_Click"/>
                            <Button Content="Strukturera" Tag="Structure" Click="AssistantActionButton_Click"/>
                            <Button Content="Förbättra språket" Tag="Improve" Click="AssistantActionButton_Click"/>
                            <Button Content="Gör punktlista" Tag="BulletList" Click="AssistantActionButton_Click"/>
                            <TextBlock Text="Egen instruktion" FontWeight="SemiBold" Margin="3,14,3,5"/>
                            <TextBox x:Name="CustomInstruction" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                     ToolTip="Skriv vad du vill ändra, till exempel: Gör texten tydligare och dela upp den i rubriker."/>
                            <Button Content="Skicka" Tag="Custom" Style="{StaticResource PrimaryButton}"
                                    Click="AssistantActionButton_Click"/>
                            <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="{StaticResource SubtleBrush}"
                                    CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Förslag" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBox x:Name="AssistantPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Height="220" Margin="0,8"/>
                                    <Button x:Name="ApplyAssistantButton" Content="Ersätt hela dokumentet"
                                            Style="{StaticResource PrimaryButton}" Click="ApplyAssistantButton_Click"/>
                                    <Button Content="Infoga vid markören" Click="InsertAssistantButton_Click"/>
                                    <Button Content="Kopiera" Click="CopyAssistantButton_Click"/>
                                    <Button Content="Avbryt" Click="CancelAssistantButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
