<Window x:Class="LokalDiktering.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LokalDiktering.App"
        mc:Ignorable="d"
        Title="LocalDraft" Icon="Assets/LocalDraft.ico"
        Height="820" Width="1280" MinHeight="650" MinWidth="960"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown" SizeChanged="MainWindow_SizeChanged">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="{StaticResource LocalDraftLogo}" Width="28" Height="28"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           AutomationProperties.Name="LocalDraft-logotyp"/>
                    <TextBlock Text="LocalDraft" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="LocalBadge" Background="{StaticResource SuccessSurfaceBrush}"
                            CornerRadius="16" Padding="12,6" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="All bearbetning sker lokalt"
                            AutomationProperties.Name="100 procent lokalt">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LocalBadgeText" Text="100 % lokalt"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE713;" Style="{StaticResource IconButton}"
                        ToolTip="Inställningar"
                        AutomationProperties.Name="Inställningar" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DocumentColumn" Width="250"/>
                <ColumnDefinition x:Name="DocumentGapColumn" Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DocumentSidebarRail" Grid.Column="0" Width="52"
                    HorizontalAlignment="Left" Style="{StaticResource CardBorder}"
                    Visibility="Collapsed">
                <Button x:Name="SidebarExpandButton" Background="Transparent" BorderThickness="0"
                        Margin="0" Padding="8,14" VerticalContentAlignment="Top"
                        ToolTip="Visa dokumentlistan" AutomationProperties.Name="Visa dokumentlistan"
                        Click="SidebarToggleButton_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dokument" FontWeight="SemiBold" Margin="0,18,0,0">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Border>

            <Border x:Name="DocumentSidebar" Grid.Column="0" Panel.ZIndex="20"
                    Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Dokument" FontSize="16" FontWeight="SemiBold"
                                   Margin="4,0,0,6" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="&#xE76B;" Style="{StaticResource IconButton}"
                                Margin="3,0,3,6"
                                ToolTip="Dölj dokumentlistan" AutomationProperties.Name="Dölj dokumentlistan"
                                Click="SidebarToggleButton_Click"/>
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PrimaryButton}"
                               AutomationProperties.Name="Nytt dokument" Click="NewDocumentButton_Click">
                            <StackPanel Orientation="Horizontal">
                               <TextBlock Text="+" FontSize="19" FontWeight="Normal" Margin="0,-2,8,0"/>
                               <TextBlock Text="Nytt dokument" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument}" SelectionChanged="DocumentList_SelectionChanged"
                             BorderThickness="0" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ModifiedLocal, StringFormat={}{0:g}}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="&#xE712;"
                                            Style="{StaticResource IconButton}"
                                            Width="34" Height="34" MinHeight="34" Margin="6,0,0,0"
                                            ToolTip="Åtgärder för dokumentet"
                                            AutomationProperties.Name="Dokumentåtgärder"
                                            Click="DocumentItemMenuButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu Placement="Bottom">
                                                <MenuItem Header="Inspelningar"
                                                          Click="RecordingsButton_Click"/>
                                                <MenuItem Header="Versioner"
                                                          Click="VersionsButton_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Kopiera dokumenttext"
                                                          Click="CopyAllButton_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Ta bort dokument…" Foreground="#A4262C"
                                                          Click="DeleteDocumentButton_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="EditorPanel" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TitleBox" FontSize="20" FontWeight="SemiBold" BorderThickness="0"
                                 AutomationProperties.Name="Dokumenttitel" TextChanged="EditorChanged"/>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                            <ComboBox x:Name="StyleBox" Width="140" SelectedIndex="0"
                                      Style="{StaticResource ToolbarComboBox}"
                                      ToolTip="Välj textstil" AutomationProperties.Name="Textstil"
                                      SelectionChanged="StyleBox_SelectionChanged">
                                <ComboBoxItem Content="Brödtext"/>
                                <ComboBoxItem Content="Rubrik 1"/>
                                <ComboBoxItem Content="Rubrik 2"/>
                            </ComboBox>
                            <Button Content="B" FontFamily="Segoe UI" FontWeight="Bold"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Fet (Ctrl+B)" AutomationProperties.Name="Fet"
                                    Click="BoldButton_Click"/>
                            <Button Content="I" FontFamily="Segoe UI" FontStyle="Italic"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Kursiv (Ctrl+I)" AutomationProperties.Name="Kursiv"
                                    Click="ItalicButton_Click"/>
                            <Button Content="•≡" FontFamily="Segoe UI" Style="{StaticResource IconButton}"
                                    ToolTip="Punktlista" AutomationProperties.Name="Punktlista"
                                    Click="BulletButton_Click"/>
                            <Button Content="↶" FontFamily="Segoe UI Symbol" Style="{StaticResource IconButton}"
                                    ToolTip="Ångra (Ctrl+Z)" AutomationProperties.Name="Ångra"
                                    Click="UndoButton_Click"/>
                            <Button Content="↷" FontFamily="Segoe UI Symbol" Style="{StaticResource IconButton}"
                                    ToolTip="Gör om (Ctrl+Y)" AutomationProperties.Name="Gör om"
                                    Click="RedoButton_Click"/>
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Background="White">
                                <RichTextBox x:Name="Editor" BorderThickness="0" Padding="18"
                                             FontFamily="Segoe UI" FontSize="15"
                                             VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                                             TextChanged="EditorChanged" SelectionChanged="Editor_SelectionChanged"
                                             AutomationProperties.Name="Dokumenttext"/>
                            </Border>
                            <Border x:Name="SelectionAssistantBar" Visibility="Collapsed" Panel.ZIndex="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Background="White" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4"
                                    Effect="{StaticResource PanelShadow}">
                                <Button Content="Bearbeta markerad text" Padding="10,5" MinHeight="32"
                                        Click="OpenAssistantButton_Click"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button FontSize="16" Padding="22,10" Style="{StaticResource PrimaryButton}"
                                        ToolTip="Diktera (Ctrl+D)"
                                        Click="DictateButton_Click" AutomationProperties.Name="Diktera">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18" Margin="0,0,9,0"/>
                                        <TextBlock Text="Diktera"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenAssistantButton_Click"
                                        ToolTip="Bearbeta text (Ctrl+Shift+A)"
                                        AutomationProperties.Name="Öppna verktyg för att bearbeta text">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✦" FontFamily="Segoe UI Symbol"
                                                   FontSize="17" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Bearbeta text"/>
                                    </StackPanel>
                                </Button>
                                <Border x:Name="SelectedMicrophoneBadge"
                                        Background="{StaticResource SubtleBrush}" CornerRadius="8"
                                        Padding="10,7" Margin="8,4,4,4"
                                        AutomationProperties.Name="Vald mikrofon">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="SelectedMicrophoneText"
                                                   Text="Läser mikrofon…"
                                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" AutomationProperties.Name="Sparstatus"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="CancelOperationButton" Content="Avbryt" Visibility="Collapsed"
                                        Margin="10,0,0,0" Click="CancelOperationButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AssistantPanel" Visibility="Collapsed" Panel.ZIndex="10"
                        Width="370" HorizontalAlignment="Right" Margin="12"
                        Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16"
                        Effect="{StaticResource PanelShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Bearbeta text" FontSize="19" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right" ToolTip="Stäng textbearbetning"
                                        AutomationProperties.Name="Stäng textbearbetning"
                                        Click="CloseAssistantPanelButton_Click"/>
                            </Grid>
                            <Border Background="{StaticResource SubtleBrush}" CornerRadius="8"
                                    Padding="10,8" Margin="0,8,0,12">
                                <TextBlock x:Name="AssistantScope" Text="Bearbetar: hela dokumentet"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Text som bearbetas"/>
                            </Border>
                            <StackPanel x:Name="AssistantComposerPanel">
                                <TextBlock Text="Vad vill du göra?" FontWeight="SemiBold"
                                           FontSize="16" Margin="3,0,3,5"/>
                                <Button x:Name="CleanupAssistantButton" Tag="Cleanup" Padding="10,8"
                                        HorizontalContentAlignment="Left"
                                        Click="AssistantActionButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="Renskriv" FontWeight="SemiBold"/>
                                        <TextBlock Text="Rätta språket och ta bort utfyllnad"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Improve" Padding="10,8" HorizontalContentAlignment="Left"
                                        Click="AssistantActionButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="Förbättra" FontWeight="SemiBold"/>
                                        <TextBlock Text="Gör texten tydligare och mer lättläst"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Summarize" Padding="10,8" HorizontalContentAlignment="Left"
                                        Click="AssistantActionButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="Sammanfatta" FontWeight="SemiBold"/>
                                        <TextBlock Text="Korta ned och behåll det viktigaste"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Expander Header="Fler färdiga val" Margin="3,6">
                                    <StackPanel>
                                        <Button Content="Strukturera" Tag="Structure"
                                                Click="AssistantActionButton_Click"/>
                                        <Button Content="Gör punktlista" Tag="BulletList"
                                                Click="AssistantActionButton_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Margin="3,10,3,12"/>
                                <TextBlock Text="Beskriv vad du vill ändra" FontWeight="SemiBold"
                                           FontSize="16" Margin="3,0,3,5"/>
                                <Grid>
                                    <TextBox x:Name="CustomInstruction" AcceptsReturn="True" Height="90"
                                             TextWrapping="Wrap" TextChanged="CustomInstruction_TextChanged"
                                             AutomationProperties.Name="Egen instruktion för textbearbetning"
                                             ToolTip="Skriv vad du vill ändra, till exempel: Gör texten tydligare och dela upp den i rubriker."/>
                                    <TextBlock x:Name="CustomInstructionHint"
                                               Text="Exempel: Gör texten tydligare och dela upp den i rubriker."
                                               Foreground="#8290A3" TextWrapping="Wrap" Margin="14,10"
                                               VerticalAlignment="Top" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="CustomAssistantButton" Content="Bearbeta hela dokumentet"
                                        Tag="Custom" Style="{StaticResource PrimaryButton}"
                                        Click="AssistantActionButton_Click"/>
                                <Expander x:Name="AssistantHistorySection" Header="Tidigare förslag"
                                          Visibility="Collapsed" IsExpanded="False" Margin="3,12,3,0">
                                    <StackPanel>
                                        <ListBox x:Name="AssistantHistoryList" Height="105" Margin="0,5"
                                                BorderBrush="{StaticResource BorderBrush}">
                                            <ListBox.ItemTemplate>
                                               <DataTemplate>
                                                   <StackPanel Margin="5">
                                                       <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                                                       <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis"
                                                                  Foreground="#667085"/>
                                                   </StackPanel>
                                               </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="Rensa historik" HorizontalAlignment="Right" Padding="8,4"
                                               MinHeight="28" Click="ClearHistoryButton_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="{StaticResource SubtleBrush}"
                                    CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Granska resultatet" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Inget ändras förrän du väljer att använda resultatet."
                                              Foreground="{StaticResource SecondaryTextBrush}"
                                              TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBox x:Name="AssistantPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                            Height="220" Margin="0,8"/>
                                    <Button x:Name="ApplyAssistantButton" Content="Ersätt hela dokumentet"
                                            Style="{StaticResource PrimaryButton}" Click="ApplyAssistantButton_Click"/>
                                    <Button Content="Avbryt" Click="CancelAssistantButton_Click"/>
                                    <Expander Header="Fler alternativ" Margin="3,6">
                                        <StackPanel>
                                            <Button Content="Infoga vid markören" Click="InsertAssistantButton_Click"/>
                                            <Button Content="Kopiera till Windows urklipp"
                                                   Click="CopyAssistantButton_Click"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
