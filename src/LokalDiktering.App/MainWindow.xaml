<Window x:Class="LokalDiktering.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LokalDiktering.App"
        mc:Ignorable="d"
        Title="Lokal Diktering" Height="820" Width="1280" MinHeight="650" MinWidth="960"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown" SizeChanged="MainWindow_SizeChanged">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SidebarToggleButton" Grid.Column="0" Content="&#xE700;"
                        Style="{StaticResource IconButton}" Margin="0,0,10,0"
                        ToolTip="Dölj dokumentlistan" AutomationProperties.Name="Visa eller dölj dokumentlistan"
                        Click="SidebarToggleButton_Click"/>
                <TextBlock Grid.Column="1" Text="Lokal Diktering" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <Border x:Name="LocalBadge" Grid.Column="2" Background="{StaticResource SuccessSurfaceBrush}"
                        CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="100 % lokalt" Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Content="&#xE713;" Style="{StaticResource IconButton}"
                        Margin="12,0,0,0" ToolTip="Inställningar"
                        AutomationProperties.Name="Inställningar" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           AutomationProperties.Name="Sparstatus"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CancelOperationButton" Content="Avbryt" HorizontalAlignment="Right"
                        Visibility="Collapsed" Click="CancelOperationButton_Click"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DocumentColumn" Width="250"/>
                <ColumnDefinition x:Name="DocumentGapColumn" Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DocumentSidebar" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}"
                               AutomationProperties.Name="Nytt dokument" Click="NewDocumentButton_Click">
                            <StackPanel Orientation="Horizontal">
                               <TextBlock Text="+" FontSize="19" FontWeight="Normal" Margin="0,-2,8,0"/>
                               <TextBlock Text="Nytt dokument" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DocumentMenuButton" Grid.Column="1" Content="&#xE712;"
                               Style="{StaticResource IconButton}"
                               ToolTip="Fler dokumentåtgärder" AutomationProperties.Name="Fler dokumentåtgärder"
                               Click="DocumentMenuButton_Click">
                            <Button.ContextMenu>
                               <ContextMenu x:Name="DocumentMenu" Placement="Bottom">
                                   <MenuItem Header="Inspelningar" Click="RecordingsButton_Click"/>
                                   <MenuItem Header="Versioner" Click="VersionsButton_Click"/>
                                   <Separator/>
                                   <MenuItem Header="Kopiera allt" Click="CopyAllButton_Click"/>
                                   <Separator/>
                                   <MenuItem Header="Ta bort dokument…" Foreground="#A4262C"
                                             Click="DeleteDocumentButton_Click"/>
                               </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="3,10,3,8">
                        <TextBox x:Name="SearchBox" Padding="34,8,9,8"
                                Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Sök dokument" AutomationProperties.Name="Sök dokument"
                                TextChanged="FilterTextBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                                  Margin="11,0,0,0" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Sök dokument" Foreground="#8290A3"
                                  Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument}" SelectionChanged="DocumentList_SelectionChanged"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ModifiedLocal, StringFormat={}{0:g}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="EditorPanel" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TitleBox" FontSize="20" FontWeight="SemiBold" BorderThickness="0"
                                 AutomationProperties.Name="Dokumenttitel" TextChanged="EditorChanged"/>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                            <ComboBox x:Name="StyleBox" Width="125" Height="36" SelectedIndex="0"
                                      SelectionChanged="StyleBox_SelectionChanged">
                                <ComboBoxItem Content="Brödtext"/>
                                <ComboBoxItem Content="Rubrik 1"/>
                                <ComboBoxItem Content="Rubrik 2"/>
                            </ComboBox>
                            <Button Content="B" FontFamily="Segoe UI" FontWeight="Bold"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Fet (Ctrl+B)" AutomationProperties.Name="Fet"
                                    Click="BoldButton_Click"/>
                            <Button Content="I" FontFamily="Segoe UI" FontStyle="Italic"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Kursiv (Ctrl+I)" AutomationProperties.Name="Kursiv"
                                    Click="ItalicButton_Click"/>
                            <Button Content="•≡" FontFamily="Segoe UI" Style="{StaticResource IconButton}"
                                    ToolTip="Punktlista" AutomationProperties.Name="Punktlista"
                                    Click="BulletButton_Click"/>
                            <Button Content="↶" FontFamily="Segoe UI Symbol" Style="{StaticResource IconButton}"
                                    ToolTip="Ångra (Ctrl+Z)" AutomationProperties.Name="Ångra"
                                    Click="UndoButton_Click"/>
                            <Button Content="↷" FontFamily="Segoe UI Symbol" Style="{StaticResource IconButton}"
                                    ToolTip="Gör om (Ctrl+Y)" AutomationProperties.Name="Gör om"
                                    Click="RedoButton_Click"/>
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Background="White">
                                <RichTextBox x:Name="Editor" BorderThickness="0" Padding="18"
                                             FontFamily="Segoe UI" FontSize="15"
                                             VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                                             TextChanged="EditorChanged" SelectionChanged="Editor_SelectionChanged"
                                             AutomationProperties.Name="Dokumenttext"/>
                            </Border>
                            <Border x:Name="SelectionAssistantBar" Visibility="Collapsed" Panel.ZIndex="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Background="White" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4"
                                    Effect="{StaticResource PanelShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Renskriv" Tag="Cleanup" Padding="8,4" MinHeight="30"
                                            Click="AssistantActionButton_Click"/>
                                    <Button Content="Förbättra" Tag="Improve" Padding="8,4" MinHeight="30"
                                            Click="AssistantActionButton_Click"/>
                                    <Button Content="Sammanfatta" Tag="Summarize" Padding="8,4" MinHeight="30"
                                            Click="AssistantActionButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button FontSize="16" Padding="22,10" Style="{StaticResource PrimaryButton}"
                                        ToolTip="Diktera (Ctrl+D)"
                                        Click="DictateButton_Click" AutomationProperties.Name="Diktera">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18" Margin="0,0,9,0"/>
                                        <TextBlock Text="Diktera"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenAssistantButton_Click"
                                        ToolTip="Textassistent (Ctrl+Shift+A)"
                                        AutomationProperties.Name="Öppna textassistent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✦" FontFamily="Segoe UI Symbol"
                                                   FontSize="17" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Textassistent"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,0,5,0"/>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Sparas automatiskt"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AssistantPanel" Visibility="Collapsed" Panel.ZIndex="10"
                        Width="370" HorizontalAlignment="Right" Margin="12"
                        Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16"
                        Effect="{StaticResource PanelShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Textassistent" FontSize="19" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right" ToolTip="Stäng textassistent"
                                        AutomationProperties.Name="Stäng textassistent"
                                        Click="CloseAssistantPanelButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="AssistantScope" Text="Hela dokumentet" Foreground="#667085"
                                       Margin="0,4,0,12" AutomationProperties.Name="Text som bearbetas"/>
                            <StackPanel x:Name="AssistantComposerPanel">
                                <StackPanel x:Name="AssistantHistorySection" Visibility="Collapsed">
                                    <TextBlock Text="Senaste förslag" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ListBox x:Name="AssistantHistoryList" Height="105" Margin="0,0,0,5"
                                             BorderBrush="{StaticResource BorderBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="5">
                                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis"
                                                               Foreground="#667085"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Rensa historik" HorizontalAlignment="Right" Padding="8,4"
                                            MinHeight="28" Click="ClearHistoryButton_Click"/>
                                </StackPanel>
                                <TextBlock Text="Snabbval" FontWeight="SemiBold" Margin="3,8,3,5"/>
                                <Button Content="Renskriv" Tag="Cleanup" Click="AssistantActionButton_Click"/>
                                <Button Content="Förbättra språket" Tag="Improve" Click="AssistantActionButton_Click"/>
                                <Button Content="Sammanfatta" Tag="Summarize" Click="AssistantActionButton_Click"/>
                                <Expander Header="Fler åtgärder" Margin="3,6">
                                    <StackPanel>
                                        <Button Content="Strukturera" Tag="Structure"
                                                Click="AssistantActionButton_Click"/>
                                        <Button Content="Gör punktlista" Tag="BulletList"
                                                Click="AssistantActionButton_Click"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Egen instruktion" FontWeight="SemiBold" Margin="3,14,3,5"/>
                                <TextBox x:Name="CustomInstruction" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                         AutomationProperties.Name="Egen instruktion till textassistenten"
                                         ToolTip="Skriv vad du vill ändra, till exempel: Gör texten tydligare och dela upp den i rubriker."/>
                                <Button Content="Kör instruktionen" Tag="Custom" Style="{StaticResource PrimaryButton}"
                                        Click="AssistantActionButton_Click"/>
                            </StackPanel>
                            <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="{StaticResource SubtleBrush}"
                                    CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Granska förslaget" FontWeight="SemiBold" FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" ToolTip="Stäng förslag"
                                                AutomationProperties.Name="Stäng förslag"
                                                Click="CancelAssistantButton_Click"/>
                                    </Grid>
                                    <TextBox x:Name="AssistantPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Height="220" Margin="0,8"/>
                                    <Button x:Name="ApplyAssistantButton" Content="Använd i hela dokumentet"
                                            Style="{StaticResource PrimaryButton}" Click="ApplyAssistantButton_Click"/>
                                    <Button Content="Infoga vid markören" Click="InsertAssistantButton_Click"/>
                                    <Button Content="Kopiera" Click="CopyAssistantButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
