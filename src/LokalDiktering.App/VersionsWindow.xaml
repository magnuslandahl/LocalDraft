<Window x:Class="LokalDiktering.App.VersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versioner" Height="520" Width="680" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Avbryt" IsCancel="True"/>
            <Button Content="Återställ vald version" Style="{StaticResource PrimaryButton}"
                    Click="RestoreButton_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Versioner" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ListBox x:Name="VersionList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding Reason}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CreatedLocal, StringFormat={}{0:g}}" Foreground="#667085"/>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
