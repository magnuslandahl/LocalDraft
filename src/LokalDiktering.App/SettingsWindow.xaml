<Window x:Class="LokalDiktering.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inställningar" Height="640" Width="680" MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,28,28,12">
                <TextBlock x:Name="HeadingText" Text="Inställningar" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="IntroText" Text="Välj den mikrofon som ska användas för diktering."
                           TextWrapping="Wrap" Margin="0,8,0,20" Foreground="#475467"/>

                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                           <Border Width="38" Height="38" CornerRadius="19"
                                   Background="#E7F0FA" Margin="0,0,12,0">
                               <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="17" Foreground="{StaticResource AccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                           </Border>
                           <StackPanel VerticalAlignment="Center">
                               <TextBlock Text="Mikrofon för diktering"
                                          FontSize="17" FontWeight="SemiBold"/>
                               <TextBlock Text="Används nästa gång du trycker på Diktera"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          FontSize="12" Margin="0,2,0,0"/>
                           </StackPanel>
                        </StackPanel>

                        <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name"
                                 Style="{StaticResource ToolbarComboBox}"
                                 Margin="0,0,0,10" AutomationProperties.Name="Mikrofon"/>
                        <Grid>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="Auto"/>
                               <ColumnDefinition Width="*"/>
                           </Grid.ColumnDefinitions>
                           <Button x:Name="TestButton" Content="Starta mikrofontest"
                                   HorizontalAlignment="Left" Margin="0"
                                   Click="TestButton_Click"/>
                           <TextBlock x:Name="TestStatusText" Grid.Column="1"
                                      Text="Kontrollera att din röst ger utslag."
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Background="{StaticResource SubtleBrush}"
                               CornerRadius="9" Height="58" Margin="0,10,0,0">
                           <Grid Margin="12">
                               <Rectangle x:Name="LevelTrack" Fill="#D6DEE8"
                                          Height="8" RadiusX="4" RadiusY="4"/>
                               <Rectangle x:Name="LevelBar" Fill="{StaticResource AccentBrush}"
                                          Height="22" Width="0" RadiusX="4" RadiusY="4"
                                          HorizontalAlignment="Left"/>
                           </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SuccessSurfaceBrush}" CornerRadius="12"
                        Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{StaticResource SuccessBrush}"
                                  FontSize="17" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <StackPanel Grid.Column="1">
                           <TextBlock Text="100 % lokalt" FontWeight="SemiBold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                           <TextBlock Text="Dokument, inspelningar och AI-bearbetning stannar i appmappen."
                                      TextWrapping="Wrap" Margin="0,4,10,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Läs mer" Padding="10,5" MinHeight="32"
                               VerticalAlignment="Center" Click="PrivacyDetailsButton_Click"/>
                    </Grid>
                </Border>

                <Expander x:Name="StorageSection" Header="Lagring och appinformation">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Lagringsplats" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PathText" TextWrapping="Wrap"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  Margin="0,5,0,8"/>
                        <WrapPanel>
                           <Button Content="Öppna appmappen" Click="OpenFolderButton_Click"/>
                           <Button Content="Om appen" Click="AboutButton_Click"/>
                        </WrapPanel>

                        <Border Background="#FFF4CE" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                           <TextBlock TextWrapping="Wrap"
                                      Text="Placera inte appen i OneDrive, Dropbox, Google Drive eller en nätverksmapp. Windows urklippshistorik kan spara text som du själv kopierar och kan stängas av i Windows inställningar."/>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Avbryt" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="Spara" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
