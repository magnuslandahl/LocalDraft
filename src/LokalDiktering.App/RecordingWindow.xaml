<Window x:Class="LokalDiktering.App.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diktera" Height="420" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Diktera" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Inspelningen startar automatiskt. Tala i din vanliga takt."
                      Margin="0,6,0,10" Foreground="{StaticResource SecondaryTextBrush}"/>
            <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                              Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MicrophoneText" Text="Läser mikrofon…"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,10">
            <Ellipse x:Name="RecordingDot" Width="18" Height="18" Fill="#999999" Margin="0,0,10,0"/>
            <TextBlock x:Name="StateText" Text="Förbereder inspelning…" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="18" Margin="20,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Height="90" Margin="0,8">
            <Grid Margin="12">
                <Rectangle x:Name="LevelTrack" Fill="#E5E7EB" Height="8" RadiusX="4" RadiusY="4"/>
                <Rectangle x:Name="LevelBar" Fill="#D13438" Height="24" RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Left" Width="0"/>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="Startar…" MinWidth="190"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"
                    AutomationProperties.Name="Slutför inspelning"
                    Click="StartButton_Click"/>
            <Button x:Name="PauseButton" Content="Pausa" Visibility="Collapsed"
                    AutomationProperties.Name="Pausa eller fortsätt inspelning"
                    Click="PauseButton_Click"/>
            <Button Content="Avbryt" IsCancel="True" Click="CancelButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
