<Window x:Class="LokalDiktering.App.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diktera" Height="430" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Diktera" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Starta inspelningen och tala i din vanliga takt."
                      Margin="0,6,0,10" Foreground="#667085"/>
            <Button x:Name="DeviceToggleButton" Content="Byt mikrofon" HorizontalAlignment="Left"
                    Padding="8,4" MinHeight="28" Click="DeviceToggleButton_Click"/>
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" Height="38" Visibility="Collapsed"
                      Margin="0,6,0,0" AutomationProperties.Name="Mikrofon"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,10">
            <Ellipse x:Name="RecordingDot" Width="18" Height="18" Fill="#999999" Margin="0,0,10,0"/>
            <TextBlock x:Name="StateText" Text="Redo" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="18" Margin="20,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Height="90" Margin="0,8">
            <Grid Margin="12">
                <Rectangle Fill="#E5E7EB" Height="8" RadiusX="4" RadiusY="4"/>
                <Rectangle x:Name="LevelBar" Fill="#D13438" Height="24" RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Left" Width="0"/>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="Starta inspelning" MinWidth="190"
                    Style="{StaticResource PrimaryButton}"
                    Click="StartButton_Click"/>
            <Button x:Name="PauseButton" Content="Pausa" Visibility="Collapsed" Click="PauseButton_Click"/>
            <Button Content="Avbryt" Click="CancelButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
